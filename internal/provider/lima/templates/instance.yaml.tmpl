# Generated by avar (avr) — do not edit by hand.
#
# avar owns this machine's configuration and rewrites it when the set of shared
# project directories changes. Machines, mounts, SSH and images are avar's
# problem, not yours: run `avr status` to see what exists.
minimumLimaVersion: {{ q .MinimumLimaVersion }}

os: "Linux"
arch: {{ q .Arch }}

# {{ .VMComment }}
vmType: {{ q .VMType }}

# Pinned, digest-verified cloud image. Lima refuses the download if the digest
# does not match, so a compromised or truncated mirror cannot boot this machine.
images:
- location: {{ q .ImageLocation }}
  arch: {{ q .Arch }}
  digest: {{ q .ImageDigest }}

# Conservative and host-proportional, so that provisioning a Linux environment
# never destabilises the Mac it runs on.
cpus: {{ .CPUs }}
memory: {{ q .Memory }}
disk: {{ q .Disk }}

# Project directories only, shared writable at the identical absolute path so
# that a path printed in Linux means the same thing in macOS. The home
# directory is deliberately absent: the guest gets what the user registered by
# running avr in a directory, and nothing else.
mountType: {{ q .MountType }}
{{- if .Mounts }}
mounts:
{{- range .Mounts }}
- location: {{ q . }}
  mountPoint: {{ q . }}
  writable: true
{{- end }}
{{- else }}
mounts: []
{{- end }}
{{- if .Rosetta }}

# Rosetta lets this native arm64 guest execute x86_64 Linux binaries directly,
# which covers "run this one Intel binary" without emulating a whole machine.
rosetta:
  enabled: true
  binfmt: true
{{- end }}

# avar is a shell environment switcher, not a container runtime: skipping
# containerd keeps first-run provisioning short and the guest small.
containerd:
  system: false
  user: false

# Nothing crosses from the host that the user did not ask for. No host public
# keys beyond Lima's own instance key, no agent forwarding, no X11, and no
# proxy variables lifted out of the host shell.
ssh:
  loadDotSSHPubKeys: false
  forwardAgent: false
  forwardX11: false
  forwardX11Trusted: false
propagateProxyEnv: false

# The guest is long-lived and entered interactively; upgrading every package on
# first boot would turn a one-time wait into several minutes for no benefit the
# user asked for.
upgradePackages: false
