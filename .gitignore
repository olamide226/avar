# Build output
/bin/
/dist/
avr

# Documentation site build output and local Ruby bundle
/site/_site/
/site/.jekyll-cache/
/site/.bundle/
/site/vendor/

# Test and coverage artifacts
coverage.out
*.test

# Local agent worktrees and machine-local Claude Code settings
.claude/

# Scratch space that travels with the checkout but is never committed:
# agent briefs, handoff notes, throwaway scripts. Anything here is by
# definition a moment in time, which is precisely why it does not belong in
# the history.
/tmp/

# Local environment files. Never committed: this repository is public, and a
# token that reaches history is a token that has to be revoked.
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
